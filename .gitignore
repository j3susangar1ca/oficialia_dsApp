# Entorno
.venv/
venv/
__pycache__/
*.py[cod]

# Empaquetado Windows (packaging/build_windows.ps1) — artefactos generados,
# nunca se versionan: build/ (venv + Chromium vendorizado + temp de
# PyInstaller) y dist/ (bundle onedir + instalador final .exe).
build/
dist/

# Secretos
.env
credentials.json

# Datos operativos locales
data/*.db
data/*.db-*
data/tablero_local.csv
data/sheets_backup.csv
logs/

# Pruebas
.pytest_cache/

# Documentos del ciclo de vida físico
storage/01_entrada/*
storage/02_en_proceso/*
storage/03_procesados/*
storage/04_errores/*
!storage/**/.gitkeep
