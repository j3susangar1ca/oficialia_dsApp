# =====================================================================
# Oficialia-Digital-DSA (100% Python) — plantilla de entorno
# Copie este archivo como `.env` (chmod 600 en el servidor) y llene
# únicamente lo que use. Todos los valores tienen un default seguro
# para pruebas locales: sin configurar nada, RPA y Sheets corren en
# modo simulación/stub.
# =====================================================================

# --- Interfaz (NiceGUI) -------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
MAX_UPLOAD_BYTES=26214400

# --- Persistencia ---------------------------------------------------------------
# Rutas por defecto: ./data/oficialia.db y ./storage/ (relativas al proyecto)
# DATABASE_PATH=data/oficialia.db
# STORAGE_ROOT=storage

# --- Extracción IA (Gemini 2.5 Flash) -----------------------------------------
# Sin API key la extracción falla de forma honesta y el documento queda
# registrado con el error (no hay stub de IA: los datos serían falsos).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_REINTENTOS=2
RENDER_DPI=300
RENDER_MAX_PAGINAS=10

# --- Vigilancia de carpeta (storage/01_entrada) -------------------------------
WATCHFOLDER_ENABLED=true
WATCHFOLDER_INTERVALO_MS=5000
WATCHFOLDER_ESTABILIDAD_MS=4000
WATCHFOLDER_MAX_REINTENTOS=5

# --- RPA (Intranet Webix) -------------------------------------------------------
# RPA_MODO=simulacion  → modo seguro para pruebas locales (sin navegador)
# RPA_MODO=playwright  → automatización real contra op_cucs.fwx
RPA_MODO=simulacion
# false = navegador VISIBLE (depuración); true = sin ventana
RPA_HEADLESS=false
RPA_TIMEOUT_MS=90000
RPA_REINTENTOS=3
# Provoca que la simulación falle (para ejercitar la ruta ERROR_RPA)
RPA_SIMULACION_FALLAR=false

INTRANET_BASE_URL=https://sii.hcg.gob.mx/intranet/op_cucs.fwx
# Credenciales HTTP Basic/Digest de la Intranet (si aplica)
INTRANET_HTTP_USERNAME=
INTRANET_HTTP_PASSWORD=
# CVEs institucionales precargadas en el formulario Webix op_ningr.fwx
# (si se omiten, la oficialía se resuelve del primer elemento del combo 'cve')
RPA_OFICIALIA_CVE=
RPA_HCG_DEPENDENCIA_CVE=
RPA_SECCION_CVE=

# Tolerancia a demoras de red, reintentos y persistencia de sesión del worker
# Playwright (todos tienen defaults seguros; normalmente no requieren ajuste).
# RPA_SELECTOR_TIMEOUT_MS=15000
# RPA_WEBIX_INIT_TIMEOUT_MS=20000
# RPA_REINTENTO_BASE_MS=1000
# RPA_REINTENTO_MAX_MS=30000
# RPA_SESSION_TTL_MIN=30
# RPA_JITTER_FACTOR=0.25

# --- Google Sheets (Tablero de Control) ---------------------------------------
# Sin SPREADSHEET_ID o sin credenciales → stub local: data/tablero_local.csv
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Hoja1
# JSON de la Service Account completo, en UNA sola línea (o use
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/servicio.json fuera del .env)
GOOGLE_SERVICE_ACCOUNT_JSON=
