# =====================================================================
# Oficialia-Digital-DSA (100% Python) — plantilla de entorno
# Copie este archivo como `.env` (chmod 600 en el servidor) y llene
# únicamente lo que use. Esta instalación viene preconfigurada por
# defecto para uso real (RPA_MODO=playwright, hoja de Sheets y carpeta
# SMB de destino ya asignadas); para volver al modo seguro de pruebas
# locales sin navegador ni red, fije RPA_MODO=simulacion.
#
# SECRETOS (GEMINI_API_KEY, RPA_PASSWORD, GOOGLE_SERVICE_ACCOUNT_JSON):
# esta plantilla se versiona en git — NUNCA capture sus valores reales
# aquí. Cárguelos únicamente en su `.env` local (ya está en .gitignore).
# =====================================================================

# --- Interfaz (NiceGUI) -------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
MAX_UPLOAD_BYTES=26214400
# Firma la sesión de navegador (app.storage.user) que recuerda el "Revisor en
# turno" entre la bandeja y la revisión HITL, y es la identidad a la que se
# ata el bloqueo de edición concurrente (ver HITL_LOCK_TTL_MIN abajo). NO es
# un límite de seguridad real (LAN departamental, sin autenticación); solo
# identifica navegadores que regresan. Cambiarlo invalida sesiones abiertas.
# STORAGE_SECRET=oficialia-dsa-storage-secret-cambiar-en-produccion

# --- Persistencia ---------------------------------------------------------------
# Rutas por defecto: ./data/oficialia.db y ./storage/ (relativas al proyecto)
# DATABASE_PATH=data/oficialia.db
# STORAGE_ROOT=storage

# --- Extracción IA (Gemini 2.5 Flash) -----------------------------------------
# Sin API key la extracción falla de forma honesta y el documento queda
# registrado con el error (no hay stub de IA: los datos serían falsos).
# SECRETO: capture el valor real solo en su `.env` local (nunca en este
# archivo de plantilla, que sí se versiona en git).
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000
GEMINI_REINTENTOS=2
RENDER_DPI=300
RENDER_MAX_PAGINAS=10

# --- Vigilancia de carpeta (storage/01_entrada) -------------------------------
WATCHFOLDER_ENABLED=true
WATCHFOLDER_INTERVALO_MS=5000
WATCHFOLDER_ESTABILIDAD_MS=4000
WATCHFOLDER_MAX_REINTENTOS=5

# --- Revisión HITL --------------------------------------------------------------
# Minutos que un revisor retiene el bloqueo de edición de un documento en
# PENDIENTE_REVISION antes de considerarse abandonado (pestaña cerrada sin
# confirmar/descartar, conexión perdida). Se renueva por heartbeat mientras
# la pantalla de revisión permanece abierta.
# HITL_LOCK_TTL_MIN=3

# --- RPA (Intranet Webix) -------------------------------------------------------
# RPA_MODO=simulacion  → modo seguro para pruebas locales (sin navegador)
# RPA_MODO=playwright  → automatización real contra op_cucs.fwx (default de
#                         esta instalación; requiere `playwright install chromium`
#                         y las credenciales RPA_USUARIO/RPA_PASSWORD de abajo)
RPA_MODO=playwright
# false = navegador VISIBLE (depuración); true = sin ventana
RPA_HEADLESS=false
RPA_TIMEOUT_MS=90000
RPA_REINTENTOS=3
# 'auto' (default): usa el Microsoft Edge YA instalado en Windows 10/11 —
# sin descargar nada — y solo si no está disponible cae al Chromium
# empaquetado por el instalador (packaging/oficialia.iss, componente
# opcional). 'msedge' o 'chromium' para forzar uno específico.
RPA_NAVEGADOR=auto
# Provoca que la simulación falle (para ejercitar la ruta ERROR_RPA)
RPA_SIMULACION_FALLAR=false

INTRANET_BASE_URL=https://sii.hcg.gob.mx/intranet/op_cucs.fwx
# Credenciales HTTP Basic/Digest de la Intranet (si aplica; tienen prioridad
# sobre RPA_USUARIO/RPA_PASSWORD cuando ambas están presentes)
INTRANET_HTTP_USERNAME=
INTRANET_HTTP_PASSWORD=
# Cuenta institucional para el login SII/Webix. RPA_USUARIO es la clave de
# empleado (no es secreta por sí sola). RPA_PASSWORD SÍ ES SECRETO: capture
# el valor real solo en su `.env` local, nunca en este archivo de plantilla.
RPA_USUARIO=2010226
RPA_PASSWORD=
# CVEs institucionales precargadas en el formulario Webix op_ningr.fwx.
# RPA_OFICIALIA_CVE=FDSA confirmado para esta instalación: en esta cuenta
# el combo 'cve' nunca carga sus opciones por sí solo (confirmado vacío
# incluso forzando open()/close() desde el RPA), así que este valor es
# obligatorio en la práctica, no un simple fallback — FDSA = (FDSA)
# División de Servicios Administrativos.
RPA_OFICIALIA_CVE=FDSA
RPA_HCG_DEPENDENCIA_CVE=
# Sección/Subsección archivística (campo opcional). Default "0000" =
# "Documentos de uso administrativo" (correspondencia rutinaria); use
# "1000" ("Documentos de relevancia institucional") solo en casos
# excepcionales. Se busca por coincidencia difusa contra el combo, así
# que también admite parte del texto visible en vez del código.
RPA_SECCION_CVE=0000

# Tolerancia a demoras de red, reintentos y persistencia de sesión del worker
# Playwright (todos tienen defaults seguros; normalmente no requieren ajuste).
# RPA_SELECTOR_TIMEOUT_MS=15000
# RPA_WEBIX_INIT_TIMEOUT_MS=20000
# RPA_REINTENTO_BASE_MS=1000
# RPA_REINTENTO_MAX_MS=30000
# RPA_SESSION_TTL_MIN=30
# RPA_JITTER_FACTOR=0.25

# --- Exportación a carpeta compartida de red (SMB) ----------------------------
# Copia (best-effort, nunca bloquea el flujo) del PDF ya canónico al
# confirmarse en HITL. Vacío → exportación desactivada.
SMB_EXPORT_DIR=\\10.2.1.92\FAA_divserv_admvos\CORRESPONDENCIA\2026

# --- Google Sheets (Tablero de Control) ---------------------------------------
# Sin SPREADSHEET_ID o sin credenciales → stub local: data/sheets_backup.csv
GOOGLE_SHEETS_SPREADSHEET_ID=1n4Y6m7DVqfp9b9cV3cMFh9NfaPde_ttE24FSYmkQOGw
GOOGLE_SHEETS_SHEET_NAME=Hoja1
# JSON de la Service Account completo, en UNA sola línea (SECRETO: solo en
# su `.env` local). Alternativas sin tocar el .env: coloque un archivo
# `credentials.json` junto a los datos de la app, o use
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/servicio.json fuera del .env)
GOOGLE_SERVICE_ACCOUNT_JSON=
